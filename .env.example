# ==========================================
# Variables de Entorno del Proyecto PongRank
# Copia este archivo a .env y define tus credenciales reales
# ==========================================

# Puerto del servidor
PORT=8080

# Conexión a Base de Datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pongrank_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Clave secreta para JWT (HMAC-SHA256, mínimo 256 bits codificados en Base64 o texto seguro)
# Puedes generar una clave segura con: openssl rand -base64 32
JWT_SECRET=reemplaza_esta_clave_por_una_secreta_y_aleatoria_de_al_menos_256_bits

# Tiempos de expiración (en milisegundos)
# Access Token: 24 horas (86400000)
JWT_EXPIRATION=86400000
# Refresh Token: 7 días (604800000)
JWT_REFRESH_EXPIRATION=604800000

# Orígenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
